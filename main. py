    def download_image(self, img_url):
        target_dir = "/sdcard/Download" if os.path.exists("/sdcard/Download") else "."
        filename = f"Resume_{os.path.basename(img_url)}"
        if not (filename.endswith(".jpg") or filename.endswith(".png")):
            filename += ".jpg"
        dest_path = os.path.join(target_dir, filename)

        try:
            if img_url.startswith("http"):
                res = requests.get(img_url, stream=True, timeout=5)
                if res.status_code == 200:
                    with open(dest_path, "wb") as f:
                        for chunk in res.iter_content(1024):
                            f.write(chunk)
            else:
                shutil.copy(img_url, dest_path)

            popup = Popup(
                title="Succes",
                content=Label(text=f"Photo enregistree dans:\n{dest_path}"),
                size_hint=(0.85, 0.35),
            )
            popup.open()
        except Exception as e:
            popup = Popup(
                title="Erreur",
                content=Label(text=f"Impossible de telecharger:\n{e}"),
                size_hint=(0.85, 0.35),
            )
            popup.open()

    def add_like(
        self, firebase_id, local_index, current_likes, btn_widget, unique_id
    ):
        new_likes = current_likes + 1
        btn_widget.text = f"Liked ✔️ ({new_likes})"
        btn_widget.background_color = (0.4, 0.4, 0.4, 1)
        btn_widget.disabled = True

        if "liked_items" not in APP_DATA:
            APP_DATA["liked_items"] = []
        if unique_id not in APP_DATA["liked_items"]:
            APP_DATA["liked_items"].append(unique_id)

        key = (
            f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
            if self.branch
            else f"{self.year}_{self.tri}_{self.subject}"
        )

        if (
            key in APP_DATA
            and local_index is not None
            and local_index < len(APP_DATA[key])
        ):
            APP_DATA[key][local_index]["likes"] = new_likes

        save_local_data(APP_DATA)

        if firebase_id:
            try:
                requests.patch(
                    f"{FIREBASE_URL}/{key}/{firebase_id}.json",
                    json={"likes": new_likes},
                    timeout=3,
                )
            except Exception as e:
                print(f"Erreur Like: {e}")

    def report_item(self, firebase_id, current_reports, btn_widget):
        if firebase_id:
            new_reports = current_reports + 1
            key = (
                f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
                if self.branch
                else f"{self.year}_{self.tri}_{self.subject}"
            )
            try:
                res = requests.patch(
                    f"{FIREBASE_URL}/{key}/{firebase_id}.json",
                    json={"reports": new_reports},
                    timeout=3,
                )
                if res.status_code == 200:
                    btn_widget.text = "Signale ✔️"
                    btn_widget.disabled = True
            except Exception as e:
                print(f"Erreur Report: {e}")

    def confirm_delete(self, firebase_id, local_index):
        content = BoxLayout(orientation="vertical", padding=10, spacing=10)
        content.add_widget(Label(text="Supprimer ce resume definitivement ?"))

        btns = BoxLayout(spacing=10, size_hint_y=0.4)
        btn_yes = Button(
            text="Oui, Supprimer",
            background_color=(0.8, 0.1, 0.1, 1),
            background_normal="",
        )
        btn_no = Button(text="Annuler", background_normal="")

        btns.add_widget(btn_no)
        btns.add_widget(btn_yes)
        content.add_widget(btns)

        popup = Popup(
            title="Confirmation", content=content, size_hint=(0.8, 0.4)
        )
        btn_yes.bind(
            on_release=lambda x: self.execute_delete(
                firebase_id, local_index, popup
            )
        )
        btn_no.bind(on_release=popup.dismiss)
        popup.open()

    def execute_delete(self, firebase_id, local_index, popup):
        key = (
            f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
            if self.branch
            else f"{self.year}_{self.tri}_{self.subject}"
        )

        if firebase_id:
            try:
                requests.delete(
                    f"{FIREBASE_URL}/{key}/{firebase_id}.json", timeout=3
                )
            except Exception as e:
                print(f"Erreur Delete Online: {e}")

        if key in APP_DATA:
            if local_index is not None and local_index < len(APP_DATA[key]):
                APP_DATA[key].pop(local_index)

        save_local_data(APP_DATA)
        popup.dismiss()
        self.load_summaries(self.year, self.tri, self.branch, self.subject)

    def open_full_image(self, img_path):
        detail_screen = self.manager.get_screen("image_detail")
        detail_screen.set_image(img_path, self.name)
        self.manager.current = "image_detail"

    def go_to_add(self, instance):
        add_screen = self.manager.get_screen("add_summary")
        add_screen.set_context(self.year, self.tri, self.branch, self.subject)
        self.manager.current = "add_summary"


