class LeaderboardScreen(Screen):

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation="vertical", padding=15, spacing=10)

        title = Label(
            text="[b]🏆 Tableau d'Honneur[/b]",
            markup=True,
            font_size="20sp",
            color=(1, 0.8, 0.2, 1),
            size_hint_y=0.1,
        )
        layout.add_widget(title)

        self.container = BoxLayout(
            orientation="vertical", spacing=10, size_hint_y=None
        )
        self.container.bind(minimum_height=self.container.setter("height"))

        scroll = ScrollView()
        scroll.add_widget(self.container)
        layout.add_widget(scroll)

        btn_back = Button(
            text="Retour",
            size_hint_y=0.1,
            background_color=(0.7, 0.2, 0.25, 1),
            background_normal="",
        )
        btn_back.bind(
            on_release=lambda x: setattr(self.manager, "current", "home")
        )
        layout.add_widget(btn_back)

        self.add_widget(layout)

    def load_leaderboard(self):
        self.container.clear_widgets()
        self.container.add_widget(
            Label(text="Chargement...", size_hint_y=None, height=40)
        )
        Clock.schedule_once(lambda dt: self.fetch_data(), 0.1)

    def fetch_data(self):
        self.container.clear_widgets()
        student_scores = {}
        try:
            for key, items in APP_DATA.items():
                if isinstance(items, list):
                    for item in items:
                        if isinstance(item, dict):
                            student = str(item.get("student", "")).strip()
                            if student:
                                likes = item.get("likes", 0)
                                if not isinstance(likes, int):
                                    likes = 0
                                if student not in student_scores:
                                    student_scores[student] = {
                                        "likes": 0,
                                        "count": 0,
                                    }
                                student_scores[student]["likes"] += likes
                                student_scores[student]["count"] += 1

            res = requests.get(f"{FIREBASE_URL}.json", timeout=4)
            if res.status_code == 200 and res.json():
                data = res.json()
                if isinstance(data, dict):
                    for cat_key, cat_data in data.items():
                        if isinstance(cat_data, dict):
                            for item_id, item in cat_data.items():
                                if isinstance(item, dict):
                                    student = str(
                                        item.get("student", "")
                                    ).strip()
                                    if student:
                                        likes = item.get("likes", 0)
                                        if not isinstance(likes, int):
                                            likes = 0
                                        if student not in student_scores:
                                            student_scores[student] = {
                                                "likes": 0,
                                                "count": 0,
                                            }
                                        student_scores[student]["likes"] = max(
                                            student_scores[student]["likes"],
                                            likes,
                                        )
        except Exception as e:
            print(f"Erreur Leaderboard: {e}")

        sorted_students = sorted(
            student_scores.items(),
            key=lambda x: (x[1]["likes"], x[1]["count"]),
            reverse=True,
        )

        if sorted_students:
            ranks = ["1st 🥇", "2nd 🥈", "3rd 🥉"]
            for index, (student, stats) in enumerate(sorted_students):
                rank_icon = ranks[index] if index < 3 else f"#{index+1}"
                card = BoxLayout(
                    orientation="horizontal",
                    size_hint_y=None,
                    height=60,
                    padding=10,
                    spacing=10,
                )
                lbl_rank = Label(
                    text=f"[b]{rank_icon}[/b]",
                    markup=True,
                    font_size="16sp",
                    size_hint_x=0.25,
                    color=(1, 0.8, 0.2, 1),
                )
                lbl_info = Label(
                    text=f"[b]{student}[/b]\n[size=12sp]{stats['count']} Resume(s) | {stats['likes']} Likes[/size]",
                    markup=True,
                    size_hint_x=0.75,
                    halign="left",
                )
                card.add_widget(lbl_rank)
                card.add_widget(lbl_info)
                self.container.add_widget(card)
        else:
            self.container.add_widget(
                Label(
                    text="Aucun resume publie pour le moment.",
                    size_hint_y=None,
                    height=40,
                )
            )


