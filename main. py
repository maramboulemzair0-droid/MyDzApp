        scroll.add_widget(self.summary_container)
        main_layout.add_widget(scroll)

        bottom_bar = BoxLayout(size_hint_y=0.1, spacing=10)
        btn_back = Button(
            text="Retour",
            background_color=(0.7, 0.2, 0.25, 1),
            background_normal="",
        )
        btn_back.bind(
            on_release=lambda x: setattr(
                self.manager, "current", "subject"
            )
        )

        btn_add = Button(
            text="+ Ajouter Resume",
            background_color=(0.12, 0.55, 0.38, 1),
            background_normal="",
        )
        btn_add.bind(on_release=self.go_to_add)

        bottom_bar.add_widget(btn_back)
        bottom_bar.add_widget(btn_add)
        main_layout.add_widget(bottom_bar)

        self.add_widget(main_layout)

    def load_summaries(self, year, tri, branch, subject):
        self.year = year
        self.tri = tri
        self.branch = branch
        self.subject = subject
        self.search_input.text = ""
        self.all_loaded_items = []

        b_text = f" > {branch}" if branch else ""
        self.header.text = f"[b]{year}{b_text} > {tri} > {subject}[/b]"
        self.summary_container.clear_widgets()

        key = (
            f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
            if self.branch
            else f"{self.year}_{self.tri}_{self.subject}"
        )

        if key in APP_DATA:
            for i, item in enumerate(APP_DATA[key]):
                item["local_index"] = i
                self.all_loaded_items.append(item)
            self.render_items(self.all_loaded_items)

        Clock.schedule_once(lambda dt: self.fetch_online_data(), 0.1)

    def fetch_online_data(self):
        key = (
            f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
            if self.branch
            else f"{self.year}_{self.tri}_{self.subject}"
        )
        try:
            response = requests.get(
                f"{FIREBASE_URL}/{key}.json", timeout=4
            )
            if response.status_code == 200 and response.json():
                online_items = response.json()
                self.all_loaded_items = []
                for item_id, item in online_items.items():
                    if isinstance(item, dict) and item.get("reports", 0) < 3:
                        item["firebase_id"] = item_id
                        self.all_loaded_items.append(item)
                self.all_loaded_items.sort(
                    key=lambda x: x.get("likes", 0), reverse=True
                )
                self.render_items(self.all_loaded_items)
        except Exception as e:
            print(f"Erreur Connexion: {e}")

    def on_search_text_change(self, instance, text):
        query = text.strip().lower()
        if not query:
            self.render_items(self.all_loaded_items)
        else:
            filtered = [
                item
                for item in self.all_loaded_items
                if query in str(item.get("student", "")).lower()
            ]
            self.render_items(filtered)

    def render_items(self, items_to_show):
        self.summary_container.clear_widgets()
        if not items_to_show:
            self.summary_container.add_widget(
                Label(
                    text="Aucun resume trouve",
                    size_hint_y=None,
                    height=40,
                )
            )
            return

        for item in items_to_show:
            images = item.get("images", [])
            if not images:
                single_img = item.get("image_url") or item.get("path", "")
                if single_img:
                    images = [single_img]

            likes = item.get("likes", 0)
            reports = item.get("reports", 0)
            fid = item.get("firebase_id") or item.get("id", None)
            idx = item.get("local_index", None)

            self.add_card_widget(
                item.get("student", ""),
                item.get("prof", ""),
                images,
                firebase_id=fid,
                local_index=idx,
                likes=likes,
                reports=reports,
            )

    def add_card_widget(
        self,
        student,
        prof,
        images,
        firebase_id=None,
        local_index=None,
        likes=0,
        reports=0,
    ):
        card = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            height=540,
            padding=10,
            spacing=5,
        )

        top_row = BoxLayout(size_hint_y=0.1, spacing=5)
        info = Label(
            text=f"[b]Eleve:[/b] {student} | [b]Prof:[/b] {prof}",
            markup=True,
            color=(1, 1, 1, 1),
        )
        btn_delete = Button(
            text="X",
            size_hint_x=0.12,
            background_color=(0.9, 0.1, 0.1, 1),
            background_normal="",
            bold=True,
        )
        btn_delete.bind(
            on_release=lambda x: self.confirm_delete(
                firebase_id, local_index
            )
        )
        top_row.add_widget(info)
        top_row.add_widget(btn_delete)
        card.add_widget(top_row)

        if images:
            current_page = [0]

            def get_formatted_url(url):
                if url.startswith("http") and not (
                    url.endswith(".jpg") or url.endswith(".png")
                ):
                    return f"https://images.weserv.nl/?url={url}"
                return url

            first_url = get_formatted_url(images[0])
