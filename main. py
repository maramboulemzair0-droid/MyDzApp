        self.search_input = TextInput(
            hint_text="🔍 Chercher par nom d'eleve...",
            multiline=False,
            size_hint_y=0.08,
        )
        self.search_input.bind(text=self.on_search_text_change)
        main_layout.add_widget(self.search_input)

        self.summary_container = BoxLayout(
            orientation="vertical", spacing=20, size_hint_y=None
        )
        self.summary_container.bind(
