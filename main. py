    def set_context(self, year, tri, branch, subject):
        self.year = year
        self.tri = tri
        self.branch = branch
        self.subject = subject
        self.selected_images = []
        self.lbl_selected_file.text = "0 photo(s) choisie(s)"
        b_text = f" ({branch})" if branch else ""
        self.title_label.text = (
            f"[b]Ajouter: {year}{b_text} - {tri} - {subject}[/b]"
        )

    def open_file_chooser(self, instance):
        box = BoxLayout(orientation="vertical", padding=10, spacing=10)
        split_box = BoxLayout(
            orientation="horizontal", spacing=10, size_hint_y=0.85
        )

        start_path = "/sdcard/DCIM" if os.path.exists("/sdcard/DCIM") else "/sdcard"
        filechooser = FileChooserListView(
            path=start_path,
            filters=["*.png", "*.jpg", "*.jpeg", "*.PNG", "*.JPG", "*.JPEG"],
            size_hint_x=0.55,
        )

        preview_image = Image(
            source="", allow_stretch=True, keep_ratio=True, size_hint_x=0.45
        )

        split_box.add_widget(filechooser)
        split_box.add_widget(preview_image)

        def show_preview(instance, selection):
            if selection:
                preview_image.source = selection[0]
                preview_image.reload()

        filechooser.bind(selection=show_preview)

        btn_layout = BoxLayout(size_hint_y=0.15, spacing=10)
        btn_close = Button(
            text="Fermer",
            background_color=(0.7, 0.2, 0.25, 1),
            background_normal="",
        )
        btn_select = Button(
            text="OK / Ajouter",
            background_color=(0.12, 0.55, 0.38, 1),
            background_normal="",
        )

        btn_layout.add_widget(btn_close)
        btn_layout.add_widget(btn_select)

        box.add_widget(split_box)
        box.add_widget(btn_layout)

        popup = Popup(
            title="Choisir une photo", content=box, size_hint=(0.95, 0.95)
        )

        def confirm_selection(obj):
            if filechooser.selection:
                path = filechooser.selection[0]
                self.selected_images.append(path)
                self.lbl_selected_file.text = (
                    f"{len(self.selected_images)} photo(s) choisie(s)"
                )
                popup.dismiss()

        btn_select.bind(on_release=confirm_selection)
        btn_close.bind(on_release=lambda x: popup.dismiss())
        popup.open()

    def publish(self, instance):
        student = self.txt_student.text.strip()
        prof = self.txt_prof.text.strip()

        if student != "" and len(self.selected_images) > 0:
            key = (
                f"{self.year}_{self.branch}_{self.tri}_{self.subject}"
                if self.branch
                else f"{self.year}_{self.tri}_{self.subject}"
            )

            payload = {
                "student": student,
                "prof": prof,
                "images": self.selected_images,
                "likes": 0,
                "reports": 0,
            }

            try:
                res = requests.post(
                    f"{FIREBASE_URL}/{key}.json", json=payload, timeout=3
                )
                if res.status_code == 200 and res.json():
                    payload["id"] = res.json().get("name")
            except Exception as e:
                print(f"Erreur Envoi Fast: {e}")

            if key not in APP_DATA:
                APP_DATA[key] = []
            APP_DATA[key].append(payload)
            save_local_data(APP_DATA)

            self.txt_student.text = ""
            self.txt_prof.text = ""
            self.selected_images = []
            self.lbl_selected_file.text = "0 photo(s) choisie(s)"

            summary_screen = self.manager.get_screen("summary_list")
            summary_screen.load_summaries(
                self.year, self.tri, self.branch, self.subject
            )
            self.manager.current = "summary_list"


